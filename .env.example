# ── Codebase-Memory (MCP 图谱引擎) ────────────────────────────────
# Codebase-Memory 单二进制的路径。MCP over stdio 方式启动。
CODEBASE_MEMORY_BIN=codebase-memory
# 启动参数，以空格分隔。通常用于指定 MCP 模式 / 目标仓库 / SQLite 图谱路径。
# 例如: --mcp --db ./.cmem/graph.sqlite --repo .
CODEBASE_MEMORY_ARGS=--mcp

# ── LLM 推理端 (OpenAI 兼容) ──────────────────────────────────────
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=abab6.5s-chat

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max

# 默认使用哪个推理端: minimax | dashscope
CODEMAP_LLM_PROVIDER=dashscope

# ── 全局黑板 ──────────────────────────────────────────────────────
BLACKBOARD_DB=./.codemap/blackboard.sqlite

# ── 并发护栏 (防止 DFS + Fork 指数爆炸) ──────────────────────────
CODEMAP_MAX_DEPTH=12
CODEMAP_MAX_WORKERS=8
